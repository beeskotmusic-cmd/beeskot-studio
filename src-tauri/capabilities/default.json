{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de l'interface BEESKOT Studio",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "process:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "updater:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://calendar.google.com/*"
        },
        {
          "url": "https://*.google.com/*"
        },
        {
          "url": "https://*.googleusercontent.com/*"
        },
        {
          "url": "https://*.googleapis.com/*"
        },
        {
          "url": "https://discord.com/*"
        },
        {
          "url": "https://*.discord.com/*"
        },
        {
          "url": "https://*.tuyaus.com/*"
        },
        {
          "url": "https://*.tuyaeu.com/*"
        },
        {
          "url": "https://*.tuyacn.com/*"
        },
        {
          "url": "https://*.tuyain.com/*"
        }
      ]
    }
  ]
}
